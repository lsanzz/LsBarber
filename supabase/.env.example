# Secrets for Edge Functions only. NEVER use the VITE_ prefix for these keys.
APP_URL=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
ALLOW_LIVE_PAYMENTS=false
# With sk_live_, restricted allows only LIVE_TEST_USER_ID to create checkout.
# Change to public only after the controlled live test and launch gates pass.
LIVE_CHECKOUT_AUDIENCE=restricted
LIVE_TEST_USER_ID=REPLACE_WITH_TEST_USER_UUID
STRIPE_PRICE_BASICO_MONTHLY=price_REPLACE
STRIPE_PRICE_BASICO_ANNUAL=price_REPLACE
STRIPE_PRICE_PLUS_MONTHLY=price_REPLACE
STRIPE_PRICE_PLUS_ANNUAL=price_REPLACE
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE
STRIPE_PRICE_PRO_ANNUAL=price_REPLACE
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase when deployed.
